<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>TaskFlow</title>
  </head>
  <body>
    <ul>
      <% tasks.forEach(task => { %>
        <li>
          <% if (task.status === "completed") { %>
            <%= task.title %> - ✅ Completed <a href="/tasks/<%= task.id %>/edit">Edit</a>
          <% } else { %>
              <%= task.title %> - ⏳ Pending <a href="/tasks/<%= task.id %>/edit">Edit</a>
          <% } %>
          <form action="/tasks/<%= task.id %>?_method=DELETE" method="post">
            <button type="submit">Delete</button>
          </form>
        </li>
      <% }); %>
    </ul>
  </body>
</html>
