<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
  </head>
  <body>
    <h2>Edit Task</h2>
    <form action="/tasks/<%= task[0].id %>?_method=PATCH" method="post">
      <div class="row">
        <label for="title">Title:</label>
        <input
          type="text"
          value="<%= task[0].title %>"
          id="title"
          name="title"
        />
      </div>

      <div class="row">
        <label for="description">Description:</label>
        <input
          type="text"
          value="<%= task[0].description %>"
          id="description"
          name="description"
        />
      </div>

      <div class="row">
        <label for="priority">Priority:</label>
        <select name="priority" id="priority">
          <% if (task[0].priority === "high") { %>
            <option selected value="high">High</option>
            <option value="medium">Medium</option>
            <option value="low">Low</option>
          <% } else if (task[0].priority === "medium") { %>
            <option value="high">High</option>
            <option selected value="medium">Medium</option>
            <option value="low">Low</option>
            <% } else { %>
              <option value="high">High</option>
              <option value="medium">Medium</option>
              <option selected value="low">Low</option>
              <% } %>
        </select>
      </div>

      <div class="row">
        <label for="status">Status:</label>
        <select name="status" id="status">
          <% if (task[0].status === "pending") { %>
            <option selected value="pending">Pending</option>
            <option value="completed">Completed</option>
          <% } else { %>
            <option value="pending">Pending</option>
            <option selected value="completed">Completed</option>
            <% } %>
        </select>
      </div>

      <div class="row">
        <label for="due_date">Due Date:</label>
        <input
          type="date"
          value="<%= task[0].due_date ? new Date(task[0].due_date).toISOString().split('T')[0] : '' %>"
          id="due_date"
          name="due_date"
        />
      </div>

      <div class="row">
        <button type="submit">Update Task</button>
      </div>
    </form>
  </body>
</html>
